{
  "name": "salonflow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:prepare": "node scripts/migrate.mjs && node scripts/seed.mjs && node scripts/seed-demo.mjs",
    "test:integration": "node scripts/integration.mjs",
    "db:generate": "drizzle-kit generate",
    "ci": "npm run lint && npm run typecheck && npm run test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@daypilot/daypilot-lite-react": "^6.2.0",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "embedded-postgres": "^18.6.0-beta.19",
    "lucide-react": "^0.511.0",
    "next": "15.1.0",
    "postgres": "^4.1.0",
    "react": "^19.0.0",
    "react-big-calendar": "^1.20.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.3.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.6.7"
