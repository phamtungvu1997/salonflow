# Local embedded PostgreSQL cluster started automatically by `npm run db:prepare`
DATABASE_URL=postgres://postgres:password@127.0.0.1:54329/salonflow

# Optional multilingual NLU. Without a key the deterministic parser is used.
# AI_RECEPTIONIST_API_KEY=
# AI_RECEPTIONIST_BASE_URL=https://api.openai.com/v1
# AI_RECEPTIONIST_MODEL=gpt-4o-mini

# Live WhatsApp stays off until the simulator is stable and the Owner enables it.
# WHATSAPP_LIVE_ENABLED=false
